<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --fg: #1f2328; --muted: #656d76; --line: #d0d7de; --bg: #ffffff;
    --soft: #f6f8fa;
    --ok: #1a7f37; --bad: #cf222e; --warn: #9a6700; --info: #0969da; --gray: #6e7781;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 32px 20px 80px; background: var(--bg); color: var(--fg);
    font: 14px/1.6 -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  }
  main { max-width: 1080px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 17px; margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  h3 { font-size: 14px; margin: 24px 0 8px; }
  .meta { color: var(--muted); font-size: 13px; }
  .meta code { background: var(--soft); padding: 1px 5px; border-radius: 4px; }
  /* 执行上下文：固定 2 列网格（四项正好 2×2），标签在上、值在下。
     用 flex-wrap 时内容放得下就不换行，看起来仍是一行 —— 这里要的是排版上分开。 */
  .meta-bar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
              gap: 12px 20px; margin: 4px 0 0; padding: 12px 16px;
              background: var(--soft); border-radius: 8px; }
  .meta-bar > div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .meta-bar dt { color: var(--muted); font-size: 11px; }
  .meta-bar dd { margin: 0; font-weight: 600; font-size: 13px; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .meta-bar { grid-template-columns: 1fr; } }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 16px 0; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
  .card .n { font-size: 26px; font-weight: 600; line-height: 1.2; }
  .card .k { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .card.pass .n { color: var(--ok); }
  .card.fail .n { color: var(--bad); }
  .card.inconclusive .n { color: var(--warn); }
  .card.invalid .n { color: var(--info); }

  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: var(--soft); font-weight: 600; color: var(--muted); font-size: 12px;
       white-space: nowrap; }
  /* 需求覆盖表：状态标记和用例编号被挤成两行就看不清了，给足最小宽度，
     让说明列去占剩余空间（它本来就能换行）。 */
  .matrix th.col-tc, .matrix td.col-tc { min-width: 320px; }
  .matrix th.col-state, .matrix td.col-state,
  .matrix th.col-verdict, .matrix td.col-verdict { min-width: 108px; }
  .matrix th.col-auto, .matrix td.col-auto { min-width: 148px; }
  .matrix th.col-note, .matrix td.col-note { width: 100%; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }

  .tag { display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .tag.pass { background: #dafbe1; color: var(--ok); }
  .tag.fail { background: #ffebe9; color: var(--bad); }
  .tag.inconclusive { background: #fff8c5; color: var(--warn); }
  .tag.invalid { background: #ddf4ff; color: var(--info); }
  .tag.none { background: var(--soft); color: var(--gray); }
  .tag.observed { background: #fff8c5; color: var(--warn); }
  .state { display: inline-block; padding: 1px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
  .state.verified { background: #dafbe1; color: var(--ok); }
  .state.unconfirmed { background: #ddf4ff; color: var(--info); }
  .state.partial { background: #fff8c5; color: var(--warn); }
  .state.inconclusive { background: #fff8c5; color: var(--warn); }
  .state.not_run { background: var(--soft); color: var(--gray); }
  .state.not_implemented { background: #ffebe9; color: var(--bad); }
  .mark-ok { color: var(--ok); }
  .mark-bad { color: var(--bad); }
  .mark-unknown { color: var(--muted); }
  .assert-intent { color: var(--fg); font-family: inherit; font-size: 12px; margin-top: 2px; }
  .assert-source { color: var(--muted); font-size: 11px; margin-top: 1px; }
  .waiver { margin-top: 4px; padding: 4px 8px; background: var(--soft); border-radius: 4px;
            font-size: 12px; color: var(--muted); }
  .tag.verified { background: #dafbe1; color: var(--ok); }

  .note { border-left: 3px solid var(--warn); background: #fffdf3; padding: 10px 14px; margin: 12px 0; font-size: 13px; }
  .note.bad { border-color: var(--bad); background: #fff5f5; }
  .note.ok { border-color: var(--ok); background: #f3fbf5; }

  .case { border: 1px solid var(--line); border-radius: 8px; margin: 12px 0; overflow: hidden; }
  .case > summary { display: flex; gap: 10px; align-items: baseline; padding: 10px 14px;
                    background: var(--soft); flex-wrap: wrap; cursor: pointer; list-style: none; }
  .case > summary::-webkit-details-marker { display: none; }
  .case > summary::before { content: "\25B8"; color: var(--muted); font-size: 11px; }
  .case[open] > summary::before { content: "\25BE"; }
  .case > summary .id { font-weight: 600; }
  .case > summary .intent { color: var(--muted); font-size: 13px; flex: 1 1 320px; }
  .case .body { padding: 4px 14px 12px; }
  .case pre { background: var(--soft); padding: 8px 10px; border-radius: 6px; overflow-x: auto; margin: 8px 0; }
  details summary { cursor: pointer; color: var(--info); font-size: 13px; margin: 6px 0; }
  .muted { color: var(--muted); }
  .empty { color: var(--muted); font-style: italic; }
  @media print { body { padding: 0; } details { display: block; }
                 .case > .body { display: block !important; } }
</style>
</head>
<body>
<main>

  <h1>{{ title }}</h1>
  <dl class="meta-bar">
    <div><dt>项目</dt><dd class="mono">{{ meta.project_id }}</dd></div>
    <div><dt>环境</dt><dd class="mono">{{ meta.environment }}</dd></div>
    <div><dt>地址</dt><dd class="mono">{{ meta.base_url }}</dd></div>
    <div><dt>执行</dt><dd class="mono">{{ meta.execution_id }}</dd></div>
  </dl>

  <!-- ============================================ 第一层：摘要 -->
  <h2>摘要</h2>

  <div class="cards">
    {% for row in summary.verdict_rows %}
    <div class="card {{ row.key }}">
      <div class="n">{{ row.count }}</div>
      <div class="k">{{ row.label }}</div>
    </div>
    {% endfor %}
  </div>

  <h3>执行是否完整</h3>
  <table>
    <thead><tr><th>执行状态</th><th class="num">数量</th></tr></thead>
    <tbody>
      {% for row in summary.status_rows %}
      <tr><td>{{ row.label }} <span class="muted mono">{{ row.key }}</span></td><td class="num">{{ row.count }}</td></tr>
      {% endfor %}
      <tr><td><strong>合计</strong></td><td class="num"><strong>{{ summary.total }}</strong></td></tr>
    </tbody>
  </table>
  {% if summary.has_no_verdict %}
  <div class="note">
    有实例没有验证结论（跳过 / 未运行 / 基础设施错误）。这些<strong>不是通过</strong>，也不计入通过率。
  </div>
  {% endif %}

  {% if summary.readonly_rows %}
  <h3>数据源只读保障</h3>
  <table>
    <thead>
      <tr><th>数据源</th><th>层</th><th>已施加</th><th>已验证</th><th>依据</th></tr>
    </thead>
    <tbody>
      {% for row in summary.readonly_rows %}
        {% for layer in row.layers %}
        <tr>
          {% if loop.first %}<td rowspan="{{ row.layers|length }}"><span class="mono">{{ row.name }}</span></td>{% endif %}
          <td>{{ layer.layer }}</td>
          <td>{{ "是" if layer.applied else "否" }}</td>
          <td class="mark-{{ 'ok' if layer.verified else ('bad' if layer.verified is false else 'unknown') }}">
            {{ layer.mark }}{% if layer.verified is none %} 未验证{% elif layer.verified %} 已生效{% else %} <strong>未生效</strong>{% endif %}
          </td>
          <td class="muted mono">{{ layer.evidence }}</td>
        </tr>
        {% endfor %}
      {% endfor %}
    </tbody>
  </table>
  {% for warning in summary.readonly_warnings %}
  <div class="note">{{ warning }}</div>
  {% endfor %}
  <div class="note">
    只读由<strong>已施加且已验证</strong>的层保证。声明了但未验证的层不计入 ——
    发出 <span class="mono">SET</span> 不等于生效（PostgreSQL 的
    <span class="mono">SET TRANSACTION READ ONLY</span> 在 autocommit 下就只作用于它自己那条语句）。
  </div>
  {% endif %}

  <h3>断言的依据覆盖</h3>
  <p>
    已证实的依据（需求 / 规范 / 参考计算）：<strong>{{ summary.basis_verified }}</strong> 条；
    仅观察到的值（measured / observed）：<strong>{{ summary.basis_unverified }}</strong> 条。
  </p>
  {% if summary.basis_unverified > 0 %}
  <div class="note">
    后者只能说明「当时是这样」，不能证明「应该这样」。它们不计入已验证覆盖。
  </div>
  {% endif %}

  {% if summary.pass_ratio is not none %}
  <p class="meta">
    通过率 {{ summary.pass_ratio }}% — 分母是跑过的实例，分子只数结论为「通过」的。
    无法验证（前提不成立）与依据不可信的实例算在分母里，但不算通过；
    跳过、未运行、基础设施错误不进分母。
  </p>
  {% else %}
  <p class="meta">未执行任何实例，无通过率。</p>
  {% endif %}

  <!-- ============================================ 第二层：需求覆盖矩阵 -->
  <h2>需求覆盖</h2>
  {% if not matrix.computable %}
  <div class="note bad">
    <strong>覆盖矩阵不可计算。</strong>{{ matrix.reason }}<br>
    没有计划清单时，无法区分「从未实现」与「本次没跑」，因此不能给出覆盖结论。
    在 apitest.yaml 里配置 <code>report.plan: plan.yaml</code> 后可计算。
  </div>
  {% else %}
  <p class="meta">
    计划范围 {{ matrix.total }} 个测试用例：
    {% for state, count in matrix.summary.items() %}{% if count %}{{ labels.state[state] }} {{ count }}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}
    {% if matrix.waived %} · 其中显式豁免 {{ matrix.waived }} 项（缺口保留）{% endif %}
  </p>
  {% if matrix.unverified %}
  <div class="note">
    仍有 <strong>{{ matrix.unverified }}</strong> 个测试用例未达到「已验证」
    （{{ matrix.gaps }} 个待补、{{ matrix.waived_gaps }} 个已豁免），见下表。
  </div>
  {% else %}
  <div class="note ok">
    计划范围内全部 {{ matrix.total }} 个测试用例均达到「已验证」，无豁免缺口。
  </div>
  {% endif %}

  <table class="matrix">
    <thead>
      <tr>
        <th class="col-tc">测试用例</th>
        <th class="col-state">覆盖状态</th>
        <th class="col-verdict">验证结论</th>
        <th class="col-auto">自动化用例</th>
        <th class="col-note">说明</th>
      </tr>
    </thead>
    <tbody>
      {% for row in matrix.rows %}
      <tr>
        <td class="mono col-tc">{{ row.tc }}{% if row.title %}<div class="muted">{{ row.title }}</div>{% endif %}</td>
        <td class="col-state"><span class="state {{ row.state }}">{{ row.state_label }}</span></td>
        <td class="col-verdict">
          {% if row.verdict %}
          <span class="tag {{ row.verdict }}">{{ row.verdict_label }}</span>
          {% else %}<span class="tag none">无结论</span>{% endif %}
        </td>
        <td class="mono col-auto">
          {% for auto_id in row.execution_ids %}{{ auto_id }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}
        </td>
        <td class="col-note">
          {{ row.note }}
          {% if row.uncovered %}
          <div class="muted">
            未覆盖：
            {% for item in row.uncovered %}
            <code>{{ item.id }}</code>{% if item.text %} {{ item.text }}{% endif %}{% if not item.id_explicit %} <span class="tag observed">ID 非显式</span>{% endif %}{% if not loop.last %}；{% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if unlinked %}
  <p class="meta">另有 {{ unlinked|length }} 条用例未关联 TC，不进矩阵，见下方证据详情。</p>
  {% endif %}

  <!-- ============================================ 第三层：证据详情 -->
  <h2>证据详情</h2>
  {% for item in executions %}
  <details class="case">
    <summary>
      <span class="id mono">{{ item.auto_id }}</span>
      {% if item.tc %}<span class="mono muted">{{ item.tc }}</span>{% endif %}
      <span class="intent">{{ item.intent }}</span>
      <span class="tag {{ item.verdict or 'none' }}">{{ item.verdict_label }}</span>
      <span class="muted mono">{{ item.status_label }} · {{ '%.3f'|format(item.duration_s) }}s</span>
    </summary>
    <div class="body">
      {% if item.message %}
      <pre>{{ item.message }}</pre>
      {% endif %}

      {% if item.cleanup_error %}
      <div class="note bad">
        <strong>清理失败</strong> —— 断言可能都已通过，但环境没恢复干净，
        这次「通过」不可信。<br>
        <span class="mono">{{ item.cleanup_error }}</span>
      </div>
      {% endif %}

      {% if item.preconditions %}
      <h3>数据前提</h3>
      <table>
        <thead><tr><th>前提</th><th>成立</th><th>来源</th><th>说明</th></tr></thead>
        <tbody>
          {% for p in item.preconditions %}
          <tr>
            <td class="mono">{{ p.name }}</td>
            <td>{% if p.holds %}是{% else %}<strong class="tag inconclusive">不成立</strong>{% endif %}</td>
            <td class="mono muted">{{ p.source.get('kind', '') }}:{{ p.source.get('ref', '') }}</td>
            <td>{{ p.message }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if item.assertions %}
      <h3>断言（{{ item.assertion_count }} 条 · 依据已证实 {{ item.basis_verified }} / 未证实 {{ item.basis_unverified }}）</h3>
      <table>
        <thead>
          <tr><th>ID</th><th>比较</th><th>期望</th><th>实际</th><th>依据</th><th>结果</th></tr>
        </thead>
        <tbody>
          {% for a in item.assertions %}
          <tr>
            <td class="mono">{{ a.id }}</td>
            <td class="mono">{{ a.kind }}</td>
            <td class="mono">
              {{ a.expected }}{% if a.tolerance is not none %} <span class="muted">±{{ a.tolerance }}</span>{% endif %}
              {% if a.intent %}<div class="assert-intent">{{ a.intent }}</div>{% endif %}
            </td>
            <td class="mono">
              {{ a.actual }}
              {% if a.actual_source %}<div class="assert-source">{{ a.actual_source }}</div>{% endif %}
            </td>
            <td>
              <span class="tag {{ 'verified' if a.basis_verified else 'observed' }}">{{ a.basis_kind }}</span>
              {% if a.basis_ref %}<div class="mono muted">{{ a.basis_ref }}</div>{% endif %}
              {% if a.basis_inputs %}
              <details><summary>入参</summary><pre>{{ a.basis_inputs }}</pre></details>
              {% endif %}
            </td>
            <td>
              {% if a.passed %}<span class="tag pass">通过</span>{% else %}<span class="tag fail">失败</span>{% endif %}
              {% if a.message %}<div class="muted">{{ a.message }}</div>{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="empty">这条用例没有产生断言 —— 它没有验证任何内容。</p>
      {% endif %}

      <details>
        <summary>用例标识</summary>
        <pre>{{ item.nodeid }}</pre>
      </details>
    </div>
  </details>
  {% endfor %}

  <p class="meta" style="margin-top:40px">
    由 apitest 生成 · schema v{{ meta.schema_version }} ·
    证据目录 <code>{{ meta.execution_id }}</code>
  </p>
</main>
</body>
</html>
